#!/bin/sh
# SGAC Maven bootstrap. Uses a cached Maven 3.9.11 or downloads it on first run.
set -e
BASEDIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
MAVEN_VERSION=3.9.11
MAVEN_HOME="$HOME/.m2/wrapper/dists/sgac-maven-$MAVEN_VERSION/apache-maven-$MAVEN_VERSION"
MVN="$MAVEN_HOME/bin/mvn"
if [ ! -f "$MVN" ]; then
  CACHE_DIR="$HOME/.m2/wrapper/dists/sgac-maven-$MAVEN_VERSION"
  mkdir -p "$CACHE_DIR"
  ARCHIVE="$CACHE_DIR/apache-maven-$MAVEN_VERSION-bin.tar.gz"
  URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/$MAVEN_VERSION/apache-maven-$MAVEN_VERSION-bin.tar.gz"
  printf 'Baixando Maven %s na primeira execucao...\n' "$MAVEN_VERSION"
  if command -v curl >/dev/null 2>&1; then
    curl --fail --location --silent --show-error "$URL" -o "$ARCHIVE"
  elif command -v wget >/dev/null 2>&1; then
    wget -q "$URL" -O "$ARCHIVE"
  else
    echo 'Instale curl ou wget para baixar o Maven.' >&2
    exit 1
  fi
  tar -xzf "$ARCHIVE" -C "$CACHE_DIR"
  rm -f "$ARCHIVE"
fi
exec sh "$MVN" "$@"
